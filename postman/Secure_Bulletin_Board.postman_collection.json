		{
			"name": "03. 보안 테스트 (Penetration Tests)",
			"item": [
				{
					"name": "3-1. CSRF — 토큰 없이 글 작성",
					"protocolProfileBehavior": {
						"followRedirects": false
					},
					"event": [
						{
							"listen": "test",
							"script": {
